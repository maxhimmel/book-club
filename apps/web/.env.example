# Copy to .env.local and fill in. Never commit .env.local.

# Convex deployment URL — printed when you run `npx convex dev`
# (also written to packages/backend/.env.local).
NEXT_PUBLIC_CONVEX_URL=

# WorkOS AuthKit — from https://dashboard.workos.com
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# A 32+ character random secret used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Must exactly match a redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
